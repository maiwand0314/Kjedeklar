# Eksempel. Ingen ekte verdier. `pnpm convex:setup:local` lager de lokale filene.
#
# .env.local – leses av Next.js. Bare offentlige verdier.
NEXT_PUBLIC_CONVEX_URL=http://127.0.0.1:3210
NEXT_PUBLIC_CONVEX_SITE_URL=http://127.0.0.1:3211
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# .env.convex-dev.local / .env.convex-test.local – leses bare av Convex CLI.
# Admin key gir full tilgang til den lokale backenden og skal aldri inn i Next.js.
# CONVEX_SELF_HOSTED_URL=http://127.0.0.1:3210
# CONVEX_SELF_HOSTED_ADMIN_KEY=<generert fra containeren>
# SEED_USER_PASSWORD=<generert, minst 12 tegn>
#
# Miljøvariabler på Convex-deploymenten (settes med `convex env set`, ikke i filer):
# BETTER_AUTH_SECRET=<tilfeldig, 32 byte>
# SITE_URL=http://localhost:3000
# KJEDEKLAR_ENV=development | test
# SEED_USER_PASSWORD=<kun lokal dev>
